@startuml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Diagrama de Contexto - Sistema de Controle de Estoque e Rastreabilidade

Person(produtor, "Produtor Rural", "Responsável pelo cadastro dos lotes, controle dos insumos e registro das aplicações.")

System(sistema, "Sistema de Controle de Estoque e Rastreabilidade", "Sistema web desenvolvido para controlar insumos agrícolas, aplicações e rastreabilidade dos lotes.")

System_Ext(fiscalizacao, "Órgãos de Fiscalização", "Órgãos que podem receber informações e relatórios relacionados às aplicações e ao uso de insumos.")

Rel(produtor, sistema, "Cadastra lotes, registra insumos e aplicações e consulta o estoque")

Rel(sistema, produtor, "Apresenta informações de estoque, aplicações e rastreabilidade")

Rel(sistema, fiscalizacao, "Gera relatórios e informações de rastreabilidade")

@enduml